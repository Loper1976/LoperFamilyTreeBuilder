# Loper Genealogy Research OS provider configuration
# Copy to .env locally. NEVER commit the real .env file.

# Data location should point to a private/local data repository.
LOPER_DATA_PATH=

# Local AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional free/cloud providers
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_TOKEN=

# Optional premium escalation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Privacy defaults
ALLOW_PUBLIC_HISTORICAL_CLOUD_AI=false
ALLOW_PRIVATE_FAMILY_CLOUD_AI=false
ALLOW_LIVING_PERSON_CLOUD_AI=false
