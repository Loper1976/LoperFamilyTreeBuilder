<Window x:Class="LoperFamilyTreeBuilder.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loper Family Tree Builder" Width="1500" Height="920"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#09111C" BorderBrush="#173347" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="LOPER" Foreground="{StaticResource CyanBrush}" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="FAMILY TREE BUILDER" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,18"/>
                    <TextBlock Text="LOCAL ARCHIVE" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                    <Border Background="#0D2130" BorderBrush="#1D6674" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,0,0,16">
                        <TextBlock Text="NATIVE WINDOWS MODE" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Tag="Dashboard" Click="Navigate_Click">Dashboard</Button>
                        <TextBlock Text="GENEALOGY" Foreground="{StaticResource MutedBrush}" Margin="4,16,0,4" FontSize="11"/>
                        <Button Tag="People" Click="Navigate_Click">People</Button>
                        <Button Tag="Person Profile" Click="Navigate_Click">Person Profile</Button>
                        <Button Tag="Family Tree" Click="Navigate_Click">Family Tree</Button>
                        <Button Tag="Relationships" Click="Navigate_Click">Relationships</Button>
                        <Button Tag="Timeline" Click="Navigate_Click">Lifetime Timeline</Button>
                        <Button Tag="Maps & Migration" Click="Navigate_Click">Maps &amp; Migration</Button>
                        <TextBlock Text="ARCHIVE" Foreground="{StaticResource MutedBrush}" Margin="4,16,0,4" FontSize="11"/>
                        <Button Tag="Photos" Click="Navigate_Click">Photos</Button>
                        <Button Tag="Documents" Click="Navigate_Click">Documents</Button>
                        <Button Tag="Sources" Click="Navigate_Click">Sources &amp; Citations</Button>
                        <TextBlock Text="INTELLIGENCE" Foreground="{StaticResource MutedBrush}" Margin="4,16,0,4" FontSize="11"/>
                        <Button Tag="Medical & Health" Click="Navigate_Click">Medical &amp; Health</Button>
                        <Button Tag="DNA Clusters" Click="Navigate_Click">DNA Clusters</Button>
                        <Button Tag="AI Transcription" Click="Navigate_Click">AI Transcription</Button>
                        <Button Tag="Tree Integrity" Click="Navigate_Click">Tree Integrity</Button>
                        <TextBlock Text="SYSTEM" Foreground="{StaticResource MutedBrush}" Margin="4,16,0,4" FontSize="11"/>
                        <Button Tag="Reports" Click="Navigate_Click">Reports</Button>
                        <Button Tag="Backup & Restore" Click="Navigate_Click">Backup &amp; Restore</Button>
                        <Button Tag="Settings" Click="Navigate_Click">Settings</Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SectionTitle" Text="Dashboard" Foreground="{StaticResource TextBrush}" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Robert J. Loper archive command center" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#11251E" BorderBrush="#2D6B53" BorderThickness="1" Padding="10,6" CornerRadius="4" Margin="0,0,8,0">
                        <TextBlock Text="LEGACY NUMBERS PROTECTED" Foreground="#77F0B0" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#0D2130" BorderBrush="#1D6674" BorderThickness="1" Padding="10,6" CornerRadius="4">
                        <TextBlock Text="LOCAL / PRIVATE" Foreground="{StaticResource CyanBrush}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#173347" BorderThickness="1" CornerRadius="8" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="WorkspaceHeading" Text="Desktop Archive Status" Foreground="{StaticResource CyanBrush}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WorkspaceDescription" Grid.Row="1" Margin="0,8,0,18" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="14"
                               Text="The local Family Tree Builder now launches as a native Windows desktop application. Browser hosting is not required for this shell."/>
                    <UniformGrid Grid.Row="2" Columns="3" Rows="2" Margin="0,8,0,0">
                        <Border Background="{StaticResource PanelAltBrush}" Margin="5" Padding="16" CornerRadius="6"><StackPanel><TextBlock Text="PEOPLE" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Archive-ready" Foreground="{StaticResource TextBrush}" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource PanelAltBrush}" Margin="5" Padding="16" CornerRadius="6"><StackPanel><TextBlock Text="RELATIONSHIPS" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Protected" Foreground="{StaticResource TextBrush}" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource PanelAltBrush}" Margin="5" Padding="16" CornerRadius="6"><StackPanel><TextBlock Text="TIMELINE / MAPS" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Integrated" Foreground="{StaticResource TextBrush}" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource PanelAltBrush}" Margin="5" Padding="16" CornerRadius="6"><StackPanel><TextBlock Text="MEDIA / SOURCES" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Integrated" Foreground="{StaticResource TextBrush}" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource PanelAltBrush}" Margin="5" Padding="16" CornerRadius="6"><StackPanel><TextBlock Text="MEDICAL / DNA" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Private" Foreground="{StaticResource TextBrush}" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource PanelAltBrush}" Margin="5" Padding="16" CornerRadius="6"><StackPanel><TextBlock Text="DEPLOYMENT" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Desktop only" Foreground="{StaticResource CyanBrush}" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="Loper Family Tree Builder • Native Windows desktop foundation" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
