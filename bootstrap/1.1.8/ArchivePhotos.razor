@page "/photos"
@rendermode InteractiveServer
@inject ArchiveLibraryService Archive

<PageTitle>Photos - Loper Family Tree Builder</PageTitle>

<div class="page-header modern-page-header">
    <div><div class="page-eyebrow">Visual Family Archive</div><h1>Photos</h1><p>Browse family photographs visually, including dates, places, GPS metadata, people links and review status.</p></div>
    <div class="page-header-actions"><a class="secondary-action inline-link-button" href="/archive/collections">Collections</a><a class="secondary-action inline-link-button" href="/archive/review">Photo Review</a><a class="primary-action inline-link-button" href="/archive/import">Import Photos</a></div>
</div>

<section class="page-card specialized-archive-toolbar photo-toolbar">
    <div class="specialized-search-row"><div class="filter-field grow-field"><label>Search photographs</label><input @bind="_request.Query" @bind:event="oninput" placeholder="Person, Legacy Number, place, photographer, caption, tag or filename" /></div><button class="primary-action" @onclick="SearchAsync">Search</button><button class="secondary-action" @onclick="ClearAsync">Clear</button></div>
    <div class="specialized-filter-row">
        <div class="filter-field"><label>Location metadata</label><select @bind="_gps"><option value="">Any</option><option value="yes">Has GPS</option><option value="no">No GPS</option></select></div>
        <div class="filter-field"><label>Review status</label><select @bind="_review"><option value="">All statuses</option>@foreach(var value in Enum.GetValues<ArchiveReviewStatus>()){<option value="@value.ToString()">@Format(value)</option>}</select></div>
        <div class="specialized-filter-note">Photos use a gallery-first view. Open an item for full EXIF/GPS, people, collection and source details.</div>
    </div>
</section>

@if(_loading){<section class="page-card loading-card"><div class="loading-indicator"></div><div><strong>Loading photographs</strong><span>Reading the visual archive.</span></div></section>}
else if(!string.IsNullOrWhiteSpace(_error)){<section class="page-card error-state-card"><div class="error-state-icon">!</div><div><h2>Photos could not be loaded</h2><p>@_error</p><button class="secondary-action" @onclick="SearchAsync">Try Again</button></div></section>}
else if(_result is not null)
{
    <div class="archive-result-summary"><strong>@_result.TotalCount.ToString("N0")</strong> photograph(s) · page @_result.Page of @_result.TotalPages</div>
    @if(_result.Items.Count==0){<section class="page-card empty-state"><h2>No matching photographs</h2><p>Import photographs or broaden the current filters.</p></section>}
    else
    {
        <section class="photo-gallery-grid">
        @foreach(var item in _result.Items)
        {
            <article class="photo-gallery-card">
                <a class="photo-gallery-preview" href="@($"/archive/item/{item.MediaFileId}")"><img src="@($"/archive/media/{item.MediaFileId}")" alt="@Title(item)" loading="lazy" />@if(item.IsFeatured){<span class="featured-media-badge">Featured</span>}</a>
                <div class="photo-gallery-body"><a class="photo-gallery-title" href="@($"/archive/item/{item.MediaFileId}")">@Title(item)</a><div class="photo-gallery-meta">@DatePlace(item)</div><div class="archive-chip-row">@if(item.LinkedPeopleCount>0){<span>@item.LinkedPeopleCount person@(item.LinkedPeopleCount==1?"":"s")</span>}@if(item.Latitude.HasValue&&item.Longitude.HasValue){<span>GPS</span>}@if(!string.IsNullOrWhiteSpace(item.DeviceOrCamera)){<span>@item.DeviceOrCamera</span>}<span>@Format(item.ReviewStatus)</span></div></div>
            </article>
        }
        </section>
        <div class="pagination-bar"><button class="secondary-action" disabled="@(!_result.HasPreviousPage)" @onclick="PreviousAsync">Previous</button><span>Page @_result.Page of @_result.TotalPages</span><button class="secondary-action" disabled="@(!_result.HasNextPage)" @onclick="NextAsync">Next</button></div>
    }
}

@code {
    private ArchiveLibrarySearchRequest _request=new(){MediaType=ArchiveMediaType.Photo,PageSize=48};
    private PagedResult<ArchiveLibraryItem>? _result; private bool _loading; private string _error=string.Empty; private string _gps=string.Empty; private string _review=string.Empty;
    protected override async Task OnInitializedAsync()=>await SearchAsync();
    private async Task SearchAsync(){_loading=true;_error=string.Empty;try{_request.MediaType=ArchiveMediaType.Photo;_request.HasGps=_gps=="yes"?true:_gps=="no"?false:null;_request.ReviewStatus=Enum.TryParse<ArchiveReviewStatus>(_review,out var r)?r:null;_result=await Archive.SearchAsync(_request);}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}
    private async Task ClearAsync(){_request=new(){MediaType=ArchiveMediaType.Photo,PageSize=48};_gps=_review=string.Empty;await SearchAsync();}
    private async Task PreviousAsync(){if(_result?.HasPreviousPage==true){_request.Page--;await SearchAsync();}}
    private async Task NextAsync(){if(_result?.HasNextPage==true){_request.Page++;await SearchAsync();}}
    private static string Title(ArchiveLibraryItem i)=>!string.IsNullOrWhiteSpace(i.Title)?i.Title:i.OriginalFileName;
    private static string DatePlace(ArchiveLibraryItem i){var parts=new[]{i.CaptureDateTime?.ToString("MMM d, yyyy"),i.ApproximateDateText,i.PlaceName}.Where(x=>!string.IsNullOrWhiteSpace(x));var text=string.Join(" · ",parts);return string.IsNullOrWhiteSpace(text)?"Date and location not yet identified":text;}
    private static string Format(Enum value)=>string.Concat(value.ToString().Select((c,i)=>i>0&&char.IsUpper(c)?" "+c:c.ToString()));
}
