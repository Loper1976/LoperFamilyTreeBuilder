@page "/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "ProjectOwner,Administrator")]
@inject UserAdministrationService UserAdmin
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Users & Permissions - Loper Family Tree Builder</PageTitle>
<div class="page-header"><div><h1>Users & Permissions</h1><p>Manage local accounts, roles, invitation records, and privacy-control foundations.</p></div></div>
@if(_summary is not null){<div class="summary-grid"><div class="summary-card"><div class="summary-value">@_summary.Users</div><div class="summary-label">Users</div></div><div class="summary-card"><div class="summary-value">@_summary.OpenInvitations</div><div class="summary-label">Open Invitations</div></div><div class="summary-card"><div class="summary-value">@_summary.PendingSubmissions</div><div class="summary-label">Pending Submissions</div></div></div>}
<section class="page-card"><h2>Create Family Account</h2><div class="archive-upload-grid"><div><label>Display name</label><input @bind="_displayName" /></div><div><label>Email</label><input type="email" @bind="_email" /></div><div><label>Temporary password</label><input type="password" @bind="_password" /></div><div><label>Role</label><select @bind="_role">@foreach(var role in Enum.GetValues<FamilyRole>()){<option value="@role">@Format(role)</option>}</select></div></div><div class="form-actions"><button class="primary-action" @onclick="CreateUserAsync">Create Account</button></div>@if(!string.IsNullOrWhiteSpace(_message)){<div class="alert">@_message</div>}</section>
<section class="page-card"><h2>Create Invitation Record</h2><div class="archive-upload-grid"><div><label>Email</label><input type="email" @bind="_inviteEmail" /></div><div><label>Intended role</label><select @bind="_inviteRole">@foreach(var role in Enum.GetValues<FamilyRole>()){<option value="@role">@Format(role)</option>}</select></div></div><div class="form-actions"><button class="secondary-action" @onclick="CreateInviteAsync">Generate One-Time Invitation</button></div>@if(_lastInvite is not null){<div class="legacy-protection-panel"><div><span>One-time invitation token</span><strong>@_lastInvite.OneTimeToken</strong></div><div>Give this token to the intended family member through a trusted channel. It is displayed only at creation time.</div></div>}</section>
<section class="page-card"><h2>Accounts</h2><div class="document-list">@foreach(var u in _users){<article class="document-row"><div><strong>@u.DisplayName</strong><div class="relationship-meta">@u.Email · @string.Join(", ",u.Roles.Select(Format))</div><small>@(u.IsLocked?"Locked":"Active") · Last login @(u.LastLoginUtc?.ToLocalTime().ToString("g")??"never")</small></div></article>}</div></section>
<section class="page-card"><h2>Invitations</h2><div class="document-list">@foreach(var i in _invitations){<article class="document-row"><div><strong>@i.Email</strong><div class="relationship-meta">@Format(i.IntendedRole) · expires @i.ExpiresUtc.ToLocalTime().ToString("g")</div><small>@(i.IsOpen?"Open":i.AcceptedUtc.HasValue?"Accepted":"Closed")</small></div></article>}</div></section>
@code{private IReadOnlyList<FamilyUserListItem> _users=[];private IReadOnlyList<InvitationListItem> _invitations=[];private CollaborationDashboardSummary? _summary;private string _displayName=string.Empty,_email=string.Empty,_password=string.Empty,_inviteEmail=string.Empty,_message=string.Empty;private FamilyRole _role=FamilyRole.FamilyMember,_inviteRole=FamilyRole.FamilyMember;private InvitationResult? _lastInvite;protected override async Task OnInitializedAsync()=>await ReloadAsync();private async Task<string> ActorAsync(){var state=await AuthenticationStateProvider.GetAuthenticationStateAsync();return state.User.Identity?.Name??"Project Owner";}private async Task ReloadAsync(){_users=await UserAdmin.GetUsersAsync();_invitations=await UserAdmin.GetInvitationsAsync();_summary=await UserAdmin.GetCollaborationSummaryAsync();}private async Task CreateUserAsync(){try{await UserAdmin.CreateUserAsync(_email,_displayName,_password,_role,await ActorAsync());_message="Account created.";_displayName=_email=_password=string.Empty;await ReloadAsync();}catch(Exception ex){_message=ex.Message;}}private async Task CreateInviteAsync(){try{_lastInvite=await UserAdmin.CreateInvitationAsync(_inviteEmail,_inviteRole,TimeSpan.FromDays(7),await ActorAsync());_inviteEmail=string.Empty;await ReloadAsync();}catch(Exception ex){_message=ex.Message;}}private static string Format(FamilyRole role)=>string.Concat(role.ToString().Select((c,i)=>i>0&&char.IsUpper(c)?" "+c:c.ToString()));}
